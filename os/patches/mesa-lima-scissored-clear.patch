+   {
+      struct lima_job *cur = lima_job_get(ctx);
+      struct pipe_scissor_state *cs = &ctx->clipped_scissor;
+      if (cur->has_clear_rect &&
+          (cs->minx < cur->clear_rect.minx || cs->maxx > cur->clear_rect.maxx ||
+           cs->miny < cur->clear_rect.miny || cs->maxy > cur->clear_rect.maxy))
+         lima_do_job(cur);
+   }
 
    /* extend the viewport in case of line draws with a line_width > 1.0f,
