    lima_clip_scissor_to_viewport(ctx);
    if (lima_is_scissor_zero(ctx))
       return;
+
+   /* After a partial (scissored) clear this job only covers the cleared tiles and
+    * does not reload them. A draw reaching outside needs the old contents there:
