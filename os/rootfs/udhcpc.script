#!/bin/sh
# BusyBox udhcpc event script.
[ -n "$1" ] || exit 1
case "$1" in
deconfig)
    ip -4 addr flush dev "$interface"
    ip link set "$interface" up
    rm -f /run/net.env
    ;;
bound|renew)
    ip -4 addr flush dev "$interface"
    ip addr add "$ip/${mask:-24}" broadcast "${broadcast:-+}" dev "$interface"
    while ip route del default dev "$interface" 2>/dev/null; do :; done
    gw=
    for r in $router; do
        [ -z "$gw" ] && gw=$r
        ip route add default via "$r" dev "$interface"
    done
    : > /etc/resolv.conf.new
    [ -n "$domain" ] && echo "search $domain" >> /etc/resolv.conf.new
    for d in $dns; do echo "nameserver $d" >> /etc/resolv.conf.new; done
    mv /etc/resolv.conf.new /etc/resolv.conf
    printf 'IFACE=%s\nIP=%s\nGATEWAY=%s\nDNS="%s"\n' "$interface" "$ip" "$gw" "$dns" > /run/net.env
    # Client-only NTP (no -l, so nothing listens). Restart to pick up the new route.
    killall ntpd 2>/dev/null
    ntpd -p time.apple.com -p pool.ntp.org ${gw:+-p $gw}
    echo "NET_BOUND $interface $ip/${mask:-24} gw=$gw dns=$dns"
    [ -c /dev/tty1 ] && (echo "network: $interface $ip gw $gw" > /dev/tty1) &
    ;;
leasefail|nak)
    echo "NET_$1 $interface"
    ;;
esac
exit 0
