ARG BASE=meowcast-builder:base
FROM ${BASE}
RUN dpkg --add-architecture armhf && apt-get update && apt-get install -y --no-install-recommends \
    g++-arm-linux-gnueabihf pkg-config ninja-build python3-venv python3-pip \
    python3-mako python3-ply python3-yaml python3-pycparser python3-packaging \
    libdrm-dev:armhf libexpat1-dev:armhf zlib1g-dev:armhf libzstd-dev:armhf \
    libelf-dev:armhf && rm -rf /var/lib/apt/lists/*
RUN python3 -m venv --system-site-packages /opt/mesa-tools && \
    /opt/mesa-tools/bin/pip install --no-cache-dir meson==1.9.1
ENV PATH="/opt/mesa-tools/bin:${PATH}"
# UI and apps: the Rust cross toolchain. (The armhf input and font libraries below are not
# linked by anything in the tree any more; they stay so that the image does not change.)
RUN apt-get update && apt-get install -y --no-install-recommends \
    libinput-dev:armhf libudev-dev:armhf libxkbcommon-dev:armhf \
    libfontconfig-dev:armhf libfreetype-dev:armhf && rm -rf /var/lib/apt/lists/*
ARG RUSTUP_VERSION=1.29.3
ARG RUST_VERSION=1.99.1
ENV RUSTUP_HOME=/opt/rustup CARGO_HOME=/opt/cargo PATH=/opt/cargo/bin:${PATH}
RUN set -eu; arch=$(uname -m); \
    case "$arch" in \
      aarch64) sum=9f608c142e0e38a78957d0661ba1dfaf0b6fb37184cfaa4b9a0aa57af6184282;; \
      x86_64)  sum=b1c8cb14e30889e7e2999e6b69e62d9e9b9ffc0f4df8180564d306d9680e6c55;; \
      *) echo "unsupported host $arch"; exit 1;; \
    esac; \
    apt-get update && apt-get install -y --no-install-recommends curl && rm -rf /var/lib/apt/lists/*; \
    curl -fsSL "https://static.rust-lang.org/rustup/archive/${RUSTUP_VERSION}/${arch}-unknown-linux-gnu/rustup-init" -o /tmp/rustup-init; \
    echo "$sum  /tmp/rustup-init" | sha256sum -c -; chmod 755 /tmp/rustup-init; \
    /tmp/rustup-init -y --no-modify-path --profile minimal --default-toolchain "$RUST_VERSION" \
      --target armv7-unknown-linux-gnueabihf; rm /tmp/rustup-init; \
    chmod -R a+rX /opt/rustup /opt/cargo; rustc --version; cargo --version
# zstd (14 Nov): the kernel compresses the initramfs with zstd -19 (kernel.config).
RUN apt-get update && apt-get install -y --no-install-recommends zstd && rm -rf /var/lib/apt/lists/*
