# Local configuration and credentials: never commit these.
config.env
.env
.env.*
!.env.example
.dev.vars
.token
*.key
*.pem
!cloud/tls/roots.pem
*.p12

# Dependencies, caches and build output.
node_modules/
vendor/
target/
dist/
dist-cloud/
build/
output/
sources/
logs/
__pycache__/
*.py[cod]
.DS_Store
*.log
*.pid
.wrangler/
.cache/

# Firmware images, device dumps and acquisition runs stay on the machine that made them.
*.bin
*.bin.chunks
*.elf
/os/deploy/
/ui/shots/
/boards/*/stock
/boards/*/flash/images/
/boards/*/flash/runs/
/boards/*/flash/log/
/boards/*/rockusb/tools
/boards/*/rockusb/ram-callback-*/
/boards/*/rockusb/*.jsonl
/boards/*/rockusb/rockusb_memory
/boards/*/rockusb/*.disassembly.txt

# The store tree is generated by apps/build-apps.sh; only the wallpapers are sources.
/cloud/store/www/apps/
/cloud/store/www/index.json
/cloud/store/www/repo.json
/cloud/store/www/assets.json
/cloud/store/www/assets.sig
/cloud/store/www/assets/fonts/
/cloud/store/keys/
/boards/*/log/
/boards/*/rockusb/log/
/boards/*/rockusb/read-*
