# wpa_supplicant build options for the dongle (build-userspace.sh). Station + access point
# (setup network) over nl80211; WPA2-PSK and open networks; no EAP methods but WSC, no D-Bus.
# P2P with Wi-Fi Display for the Miracast sink (apps/netd/src/p2p.rs); P2P needs WPS, which
# brings the EAPOL state machines and EAP-WSC. Cost: 716 KB -> 1089 KB stripped (+373 KB;
# +174 KB xz-compressed in the image). meow-netd passes p2p_disabled=1 to the station and
# the setup access point, and wps_disabled=1 to the latter.
CONFIG_DRIVER_NL80211=y
CONFIG_LIBNL32=y
CONFIG_CTRL_IFACE=y
CONFIG_BACKEND=file
CONFIG_OS=unix
CONFIG_ELOOP=eloop
CONFIG_L2_PACKET=linux
CONFIG_AP=y
CONFIG_TLS=internal
CONFIG_CRYPTO=internal
CONFIG_INTERNAL_LIBTOMMATH=y
CONFIG_INTERNAL_LIBTOMMATH_FAST=y
CONFIG_BGSCAN_SIMPLE=y
CONFIG_SME=y
# CONFIG_IEEE8021X_EAPOL is not set
# CONFIG_EAP_PSK is not set
CONFIG_WPS=y
CONFIG_P2P=y
CONFIG_WIFI_DISPLAY=y
# CONFIG_SAE is not set
# CONFIG_OWE is not set
# CONFIG_DPP is not set
# CONFIG_MESH is not set
# CONFIG_TDLS is not set
# CONFIG_WNM is not set
# CONFIG_INTERWORKING is not set
# CONFIG_HS20 is not set
# CONFIG_MBO is not set
# CONFIG_FILS is not set
# CONFIG_CTRL_IFACE_DBUS_NEW is not set
# CONFIG_READLINE is not set
