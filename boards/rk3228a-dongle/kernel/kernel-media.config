# MEDIA=1 kernel additions (build.sh appends this to kernel.config; default for the perf
# profile): the hardware video decoder and HDMI audio for video apps. Proven on hardware
# 14 Nov 2026 (1080p60 H.264 decode, HDMI sound; see apps/youtube/README.md).
#
# Video: rkvdec ("rockchip,rk3228-vdec", V4L2 stateless/request API) decodes H.264, HEVC
# and VP9. The Hantro VPU ("rockchip,rk3228-vpu") only adds MPEG-2/VP8 on this SoC and is
# left out to save flash.
CONFIG_MEDIA_SUPPORT=y
CONFIG_MEDIA_SUPPORT_FILTER=y
CONFIG_MEDIA_PLATFORM_SUPPORT=y
# CONFIG_MEDIA_SUBDRV_AUTOSELECT is not set
CONFIG_MEDIA_CONTROLLER=y
# (the request API is always built with the media controller in 7.3; no symbol to set)
CONFIG_MEDIA_PLATFORM_DRIVERS=y
CONFIG_V4L_MEM2MEM_DRIVERS=y
CONFIG_VIDEO_ROCKCHIP_VDEC=y
# Audio: I2S0 feeds the DesignWare HDMI transmitter inside the SoC; one simple-audio-card.
CONFIG_SOUND=y
CONFIG_SND=y
# CONFIG_SND_DRIVERS is not set
# CONFIG_SND_ARM is not set
# CONFIG_SND_USB is not set
# CONFIG_SND_SUPPORT_OLD_API is not set
# CONFIG_SND_PROC_FS is not set
# CONFIG_SND_VERBOSE_PROCFS is not set
CONFIG_SND_SOC=y
CONFIG_SND_SOC_ROCKCHIP_I2S=y
CONFIG_SND_SIMPLE_CARD=y
CONFIG_DRM_DW_HDMI_I2S_AUDIO=y
CONFIG_DMADEVICES=y
CONFIG_PL330_DMA=y
