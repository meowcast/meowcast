CONFIG_ARCH_MULTI_V7=y
CONFIG_ARCH_ROCKCHIP=y
CONFIG_ARCH_VIRT=y
CONFIG_MMU=y
CONFIG_AEABI=y
CONFIG_VFP=y
CONFIG_ARM_PATCH_PHYS_VIRT=y
CONFIG_AUTO_ZRELADDR=y
# XZ for the kernel image too (14 Nov): the zImage is 2.5 MB smaller than gzip + zstd, for
# a few seconds of boot time (see the initramfs note below).
CONFIG_KERNEL_XZ=y
CONFIG_CC_OPTIMIZE_FOR_SIZE=y
CONFIG_PRINTK=y
CONFIG_PRINTK_TIME=y
CONFIG_BUG=y
CONFIG_KALLSYMS=y
CONFIG_FUTEX=y
CONFIG_EPOLL=y
CONFIG_SIGNALFD=y
CONFIG_TIMERFD=y
CONFIG_EVENTFD=y
CONFIG_MULTIUSER=y
CONFIG_POSIX_TIMERS=y
CONFIG_SYSCTL=y
CONFIG_BINFMT_ELF=y
CONFIG_BINFMT_SCRIPT=y
CONFIG_BLK_DEV_INITRD=y
# The initramfs is compressed by build.sh itself (xz, ARM-Thumb BCJ filter, a dictionary as
# large as the archive): 0.9 MB smaller than zstd -19 and 0.55 MB smaller than the kernel's
# own xz settings (1 MiB dictionary, no filter). Flash headroom matters more than the boot
# time here. The kernel embeds a .cpio.xz as it is; only the xz unpacker is built in.
CONFIG_INITRAMFS_SOURCE="/build/rootfs.cpio.xz"
CONFIG_RD_XZ=y
# CONFIG_RD_GZIP is not set
# CONFIG_RD_BZIP2 is not set
# CONFIG_RD_LZMA is not set
# CONFIG_RD_LZO is not set
# CONFIG_RD_LZ4 is not set
# CONFIG_RD_ZSTD is not set
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
CONFIG_PROC_FS=y
CONFIG_SYSFS=y
CONFIG_TMPFS=y
CONFIG_SHMEM=y
CONFIG_CONFIGFS_FS=y
CONFIG_DEBUG_FS=y
CONFIG_IKCONFIG=y
CONFIG_IKCONFIG_PROC=y
CONFIG_DEBUG_KERNEL=y
CONFIG_PSTORE=y
CONFIG_PSTORE_RAM=y
CONFIG_PSTORE_CONSOLE=y
CONFIG_TTY=y
CONFIG_UNIX98_PTYS=y
CONFIG_VT=y
CONFIG_VT_CONSOLE=y
CONFIG_SERIAL_AMBA_PL011=y
CONFIG_SERIAL_AMBA_PL011_CONSOLE=y
CONFIG_SERIAL_8250=y
CONFIG_SERIAL_8250_CONSOLE=y
CONFIG_SERIAL_8250_DW=y
CONFIG_SERIAL_OF_PLATFORM=y
CONFIG_HW_RANDOM=y
CONFIG_HW_RANDOM_ROCKCHIP=y
CONFIG_USB_SUPPORT=y
CONFIG_USB=y
CONFIG_USB_EHCI_HCD=y
CONFIG_USB_EHCI_HCD_PLATFORM=y
CONFIG_USB_OHCI_HCD=y
CONFIG_USB_OHCI_HCD_PLATFORM=y
CONFIG_USB_GADGET=y
CONFIG_USB_DWC2=y
CONFIG_USB_DWC2_PERIPHERAL=y
# CONFIG_USB_G_SERIAL is not set
# Composite configfs gadget (ACM console + CDC ECM/NCM Ethernet), set up by rootfs/usb-gadget.
CONFIG_USB_CONFIGFS=y
CONFIG_USB_CONFIGFS_ACM=y
CONFIG_USB_CONFIGFS_ECM=y
CONFIG_USB_CONFIGFS_NCM=y
# CONFIG_U_SERIAL_CONSOLE is not set
CONFIG_PHY_ROCKCHIP_INNO_USB2=y
CONFIG_EXTCON=y
CONFIG_REGULATOR=y
CONFIG_REGULATOR_FIXED_VOLTAGE=y
CONFIG_PM=y
CONFIG_PM_GENERIC_DOMAINS=y
CONFIG_ROCKCHIP_PM_DOMAINS=y
CONFIG_IOMMU_SUPPORT=y
CONFIG_ROCKCHIP_IOMMU=y
CONFIG_CMA=y
CONFIG_DMA_CMA=y
CONFIG_CMA_SIZE_MBYTES=16
CONFIG_I2C=y
CONFIG_I2C_RK3X=y
CONFIG_DRM=y
CONFIG_DRM_ROCKCHIP=y
CONFIG_ROCKCHIP_VOP=y
CONFIG_ROCKCHIP_DW_HDMI=y
CONFIG_DRM_DISPLAY_CONNECTOR=y
CONFIG_PHY_ROCKCHIP_INNO_HDMI=y
CONFIG_DRM_FBDEV_EMULATION=y
CONFIG_DRM_CLIENT_DEFAULT_FBDEV=y
CONFIG_FB=y
CONFIG_FRAMEBUFFER_CONSOLE=y
CONFIG_FONT_8x16=y
CONFIG_DRM_LIMA=y
CONFIG_NET=y
CONFIG_UNIX=y
CONFIG_INET=y
# udhcpc needs AF_PACKET raw sockets.
CONFIG_PACKET=y
# CONFIG_IPV6 is not set
# CONFIG_SMP is not set
# CONFIG_CPU_FREQ is not set
# CONFIG_CPU_IDLE is not set
# CONFIG_MODULES is not set
# CONFIG_MTD is not set
# CONFIG_SPI is not set
# CONFIG_MMC is not set
# CONFIG_DEVMEM is not set
# CONFIG_KEXEC is not set
# CONFIG_SUSPEND is not set
# CONFIG_HIBERNATION is not set
# CONFIG_BLOCK is not set
