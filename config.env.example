# meowcast configuration. Copy to config.env (ignored by git) and fill in what you use.
# Plain KEY=VALUE lines; the environment overrides this file. Nothing here is a secret by
# itself, but it names your own accounts and files, so it stays out of the repository.
# Reference: docs/CONFIGURATION.md.

# ---- What to build ---------------------------------------------------------------------
# A directory under boards/.
BOARD=rk3228a-dongle
# LAB=1 adds debug machinery (writable register debugfs, automatic return to the boot ROM).
# Use LAB=0 for a device you give to someone.
#LAB=0

# ---- Your cloud side (docs/CLOUD.md; `./meow cloud deploy` fills these in) -------------
# The app store and asset host the firmware downloads from. Empty: no store.
MEOW_STORE_URL=
# The relay that connects phones to the device. Host name only. Empty: no cloud link.
MEOW_RELAY_HOST=
# The phone remote web app; the TV's pairing QR code points here.
MEOW_PILOT_URL=

# Cloudflare Worker names used by `./meow cloud deploy`. Change them to run several
# deployments (for example a development and a production one) in one account.
MEOW_CF_RELAY_NAME=meowcast-relay
MEOW_CF_PILOT_NAME=meowcast-pilot
MEOW_CF_STORE_NAME=meowcast-store
# wrangler signs in with `npx wrangler login`. For CI set these two in the environment
# instead (never in a committed file):
#CLOUDFLARE_ACCOUNT_ID=
#CLOUDFLARE_API_TOKEN=

# ---- Store signing key -----------------------------------------------------------------
# Private key that signs your apps and assets; created on the first build. Whoever has it
# can publish apps to every device built with its public half: keep it out of git and back
# it up. The name devices show for your store:
MEOW_STORE_KEY=cloud/store/keys/store.key
MEOW_STORE_NAME=meow store

# ---- Build machinery -------------------------------------------------------------------
#MEOW_BUILDER_IMAGE=meowcast-builder
#MEOW_BUILD_VOLUME=meowcast-build
# Directory with clang, ld.lld and llvm-objcopy for the bare-metal host tools of a board.
#MEOW_LLVM=/opt/homebrew/opt/llvm/bin

# ---- Board: rk3228a-dongle -------------------------------------------------------------
# Your unit's own full flash dump and its SHA-256 (docs: boards/rk3228a-dongle/README.md).
#MEOW_STOCK_DUMP=boards/rk3228a-dongle/stock/nor-stock.bin
#MEOW_STOCK_SHA256=
